+def end_period(pid, end_date):
+    """Update the existing record in this line's DB, never delete or recreate it."""
+    conn = get_db()
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        row = conn.execute("SELECT start_date,end_date FROM period_logs WHERE id=?", (pid,)).fetchone()
+        if row is None:
+            raise LookupError("period not found")
+        end = datetime.date.fromisoformat(end_date)
+        if end < datetime.date.fromisoformat(row["start_date"]):
+            raise ValueError("end precedes start")
+        if row["end_date"] and row["end_date"] != end_date:
+            raise ValueError("period already ended on a different date")
+        conn.execute("UPDATE period_logs SET end_date=? WHERE id=?", (end_date, pid))
+        conn.commit()
+    finally:
+        conn.close()
