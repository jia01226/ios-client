+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        # Retry of a start must not create a second cycle or erase an existing end.
+        row = conn.execute("SELECT id FROM period_logs WHERE start_date=? ORDER BY id DESC LIMIT 1", (start_date,)).fetchone()
+        if row:
+            conn.commit()
+            return row["id"]
+        cur = conn.execute("INSERT INTO period_logs (start_date,note,end_date) VALUES (?,?,?)",
+                           (start_date, note, end_date or None))
+        conn.commit()
+        return cur.lastrowid
+    finally:
+        conn.close()
