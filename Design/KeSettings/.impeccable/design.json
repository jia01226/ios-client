  "narrative": {
    "northStar": "把零散的小设置，收在一枝月色里。",
    "overview": "75% 右侧浅纸抽屉保留左侧原页面。植物目录进入八个清楚的设置页；装饰静止，操作具有直接反馈。当前为独立网页视觉提案。",
    "keyCharacteristics": [
      "四款既有白天纸色与 Pinyon 花体。",
      "透明水彩素材保留独立图层和完整画布。",
      "目录可滚动，二级设置清楚易改。"
    ],
    "rules": [
      "颜色只以 spec/tokens.json 为准。",
      "当前默认纸色以 spec/sample-data.json 为准。",
      "不把网页示例写回真实用户设置。"
    ],
    "dos": [
      "保留月牙与右边缘两个等价入口。",
      "保留焦点回返、纵向滚动与减少动态效果支持。",
      "原生接入使用真实模型、版本、权限与持久化。"
    ],
    "donts": [
      "不自行改纸色或替换花体。",
      "不把页内开关视为真实认证、通知或权限成功。",
      "不把浏览器与 Node 验证表述为真机验收。"
    ]
  }
